# --- Google Gemini LLM Configuration ---
# Required for live Gemini Flash inference via LangChain (ChatGoogleGenerativeAI).
# AI Studio automatically injects GEMINI_API_KEY at runtime when configured in Secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
LLM_PROVIDER="gemini"
GEMINI_MODEL="gemini-4-hydrogen"
LLM_TIMEOUT_SECONDS="8"

# --- LangSmith Tracing & Observability ---
# Set LANGCHAIN_TRACING_V2=true and LANGSMITH_API_KEY to stream LangGraph traces to LangSmith.
LANGCHAIN_TRACING_V2="false"
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY="MY_LANGSMITH_API_KEY"
LANGSMITH_PROJECT="sellvion-agentic-ai"

# --- Database & LangGraph Checkpointing ---
# Uses shared SQLite database by default for zero-config parity with existing store data.
# Provide a PostgreSQL URI (with pgvector extension enabled) for managed Postgres persistence:
# DATABASE_URL="postgresql://user:password@localhost:5432/sellvion"
DATABASE_URL="sqlite:///./data/sellvion.db"
LANGGRAPH_CHECKPOINT_URL="sqlite:///./data/langgraph_checkpoints.db"

# --- Optional Redis Cache & Rate Limiter ---
# Provide REDIS_URL to back short-lived analytics caches & rate limiting with Redis.
# REDIS_URL="redis://localhost:6379/0"
REDIS_URL=""

# --- Backend Bridge & Runtime URLs ---
APP_URL="MY_APP_URL"
FASTAPI_PORT="8010"
FASTAPI_AGENT_URL="http://127.0.0.1:8010"
SESSION_SECRET="change-me-in-production"
WHATSAPP_VERIFY_TOKEN="sellvion-verify-token"
