rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 0: Default-deny Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Shared Hardened Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwnerUid(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isBootstrappedAdmin() {
      return isEmailVerified() && request.auth.token.email == 'ishayadav1291@gmail.com';
    }

    function isAdmin() {
      return isEmailVerified() && (
        request.auth.token.email == 'ishayadav1291@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isWorkspaceOwner(workspaceId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/workspaces/$(workspaceId)) &&
        get(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerId == request.auth.uid;
    }

    // Validation Blueprint: UserPublicProfile
    function isValidUserPublicProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'displayName', 'photoUrl', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.displayName is string &&
        data.displayName.size() >= 1 &&
        data.displayName.size() <= 120 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: UserPrivateInfo (PII)
    function isValidUserPrivateInfo(data, userId) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'activeWorkspaceId', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.uid == userId &&
        data.uid == request.auth.uid &&
        data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 180 &&
        (!('activeWorkspaceId' in data) || isValidId(data.activeWorkspaceId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: MerchantWorkspace
    function isValidAutonomyLevel(level) {
      return level in ['recommendation_only', 'approval_required', 'bounded_autonomous'];
    }

    function isValidMerchantWorkspace(data, workspaceId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'name',
          'preferredLanguage',
          'emergencyPauseAll',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'ownerId',
          'name',
          'category',
          'city',
          'state',
          'storeUrl',
          'preferredLanguage',
          'emergencyPauseAll',
          'reorderReminders',
          'codPrepayNudges',
          'udhaarReminders',
          'winbackOffers',
          'maxDailyMessagesPerCustomer',
          'quietHoursStart',
          'quietHoursEnd',
          'minConfidenceForAutonomous',
          'maxAutonomousDiscountPct',
          'dailySpendCapInr',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == workspaceId &&
        isValidId(data.ownerId) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 140 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 80)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
        (!('state' in data) || (data.state is string && data.state.size() <= 80)) &&
        (!('storeUrl' in data) || (data.storeUrl is string && data.storeUrl.size() <= 300)) &&
        data.preferredLanguage in ['en', 'hi'] &&
        data.emergencyPauseAll is bool &&
        (!('reorderReminders' in data) || isValidAutonomyLevel(data.reorderReminders)) &&
        (!('codPrepayNudges' in data) || isValidAutonomyLevel(data.codPrepayNudges)) &&
        (!('udhaarReminders' in data) || isValidAutonomyLevel(data.udhaarReminders)) &&
        (!('winbackOffers' in data) || isValidAutonomyLevel(data.winbackOffers)) &&
        (!('maxDailyMessagesPerCustomer' in data) || (data.maxDailyMessagesPerCustomer is int && data.maxDailyMessagesPerCustomer >= 1 && data.maxDailyMessagesPerCustomer <= 10)) &&
        (!('quietHoursStart' in data) || (data.quietHoursStart is string && data.quietHoursStart.size() <= 10 && data.quietHoursStart.matches('^[0-9]{2}:[0-9]{2}$'))) &&
        (!('quietHoursEnd' in data) || (data.quietHoursEnd is string && data.quietHoursEnd.size() <= 10 && data.quietHoursEnd.matches('^[0-9]{2}:[0-9]{2}$'))) &&
        (!('minConfidenceForAutonomous' in data) || (data.minConfidenceForAutonomous is int && data.minConfidenceForAutonomous >= 50 && data.minConfidenceForAutonomous <= 100)) &&
        (!('maxAutonomousDiscountPct' in data) || (data.maxAutonomousDiscountPct is int && data.maxAutonomousDiscountPct >= 0 && data.maxAutonomousDiscountPct <= 50)) &&
        (!('dailySpendCapInr' in data) || (data.dailySpendCapInr is number && data.dailySpendCapInr >= 0 && data.dailySpendCapInr <= 1000000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: CustomerProfile
    function isValidCustomerProfile(data, workspaceId, customerId) {
      return data.keys().hasAll([
          'id',
          'workspaceId',
          'ownerId',
          'name',
          'segment',
          'optedOut',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'ownerId',
          'name',
          'phone',
          'city',
          'lastProductOrdered',
          'segment',
          'totalOrders',
          'totalSpent',
          'outstandingUdhaar',
          'optedOut',
          'aiInsight',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == customerId &&
        isValidId(data.workspaceId) &&
        data.workspaceId == workspaceId &&
        isValidId(data.ownerId) &&
        data.name is string &&
        data.name.size() >= 1 &&
        data.name.size() <= 120 &&
        (!('phone' in data) || (data.phone is string && data.phone.size() <= 32)) &&
        (!('city' in data) || (data.city is string && data.city.size() <= 80)) &&
        (!('lastProductOrdered' in data) || (data.lastProductOrdered is string && data.lastProductOrdered.size() <= 140)) &&
        data.segment in ['regular', 'loyal', 'reorder_due', 'at_risk', 'inactive', 'high_udhaar', 'first_time'] &&
        (!('totalOrders' in data) || (data.totalOrders is int && data.totalOrders >= 0)) &&
        (!('totalSpent' in data) || (data.totalSpent is number && data.totalSpent >= 0)) &&
        (!('outstandingUdhaar' in data) || (data.outstandingUdhaar is number && data.outstandingUdhaar >= 0)) &&
        data.optedOut is bool &&
        (!('aiInsight' in data) || (data.aiInsight is string && data.aiInsight.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Validation Blueprint: DraftRevision
    function isValidDraftRevision(data, workspaceId, revisionId) {
      return data.keys().hasAll([
          'id',
          'workspaceId',
          'ownerId',
          'approvalId',
          'customerName',
          'title',
          'agentName',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id',
          'workspaceId',
          'ownerId',
          'approvalId',
          'customerName',
          'title',
          'agentName',
          'message',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.id == revisionId &&
        isValidId(data.workspaceId) &&
        data.workspaceId == workspaceId &&
        isValidId(data.ownerId) &&
        isValidId(data.approvalId) &&
        data.customerName is string &&
        data.customerName.size() >= 1 &&
        data.customerName.size() <= 120 &&
        data.title is string &&
        data.title.size() >= 1 &&
        data.title.size() <= 160 &&
        data.agentName is string &&
        data.agentName.size() >= 1 &&
        data.agentName.size() <= 100 &&
        data.message is string &&
        data.message.size() >= 1 &&
        data.message.size() <= 1000 &&
        data.status in ['edited', 'approved', 'rejected', 'scheduled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Admins Collection (No client self-escalation allowed)
    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwnerUid(userId) || isBootstrappedAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Split PII Strategy: User Public Profile vs Private Info
    match /users/{userId}/public/{docId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && (isOwnerUid(userId) || isAdmin());
      allow list: if false;
      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isValidId(docId) &&
        docId == 'profile' &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isOwnerUid(userId);
      allow update: if isEmailVerified() &&
        isValidId(userId) &&
        isValidId(docId) &&
        docId == 'profile' &&
        isValidUserPublicProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isOwnerUid(userId) || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'updatedAt']);
      allow delete: if isEmailVerified() && isValidId(userId) && isValidId(docId) && isAdmin();
    }

    match /users/{userId}/private/{docId} {
      allow get: if isSignedIn() && isValidId(userId) && isValidId(docId) && (isOwnerUid(userId) || isAdmin());
      allow list: if false;
      allow create: if isEmailVerified() &&
        isValidId(userId) &&
        isValidId(docId) &&
        docId == 'info' &&
        isValidUserPrivateInfo(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isOwnerUid(userId);
      allow update: if isEmailVerified() &&
        isValidId(userId) &&
        isValidId(docId) &&
        docId == 'info' &&
        isValidUserPrivateInfo(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().email == existing().email &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (isOwnerUid(userId) || isAdmin()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['activeWorkspaceId', 'updatedAt']);
      allow delete: if isEmailVerified() && isValidId(userId) && isValidId(docId) && isAdmin();
    }

    // Merchant Workspaces
    match /workspaces/{workspaceId} {
      allow get: if isSignedIn() && isValidId(workspaceId) && (existing().ownerId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

      allow create: if isEmailVerified() &&
        isValidId(workspaceId) &&
        isValidMerchantWorkspace(incoming(), workspaceId) &&
        incoming().ownerId == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isEmailVerified() &&
        isValidId(workspaceId) &&
        isValidMerchantWorkspace(incoming(), workspaceId) &&
        incoming().id == existing().id &&
        incoming().ownerId == existing().ownerId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'category',
              'city',
              'state',
              'storeUrl',
              'preferredLanguage',
              'updatedAt'
            ])
          ) ||
          (
            existing().ownerId == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'emergencyPauseAll',
              'reorderReminders',
              'codPrepayNudges',
              'udhaarReminders',
              'winbackOffers',
              'maxDailyMessagesPerCustomer',
              'quietHoursStart',
              'quietHoursEnd',
              'minConfidenceForAutonomous',
              'maxAutonomousDiscountPct',
              'dailySpendCapInr',
              'updatedAt'
            ])
          ) ||
          isAdmin()
        );

      allow delete: if isEmailVerified() && isValidId(workspaceId) && (existing().ownerId == request.auth.uid || isAdmin());

      // Customer 360 Subcollection
      match /customers/{customerId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(customerId) && (isWorkspaceOwner(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

        allow create: if isEmailVerified() &&
          isValidId(workspaceId) &&
          isValidId(customerId) &&
          isValidCustomerProfile(incoming(), workspaceId, customerId) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwner(workspaceId);

        allow update: if isEmailVerified() &&
          isValidId(workspaceId) &&
          isValidId(customerId) &&
          isValidCustomerProfile(incoming(), workspaceId, customerId) &&
          incoming().id == existing().id &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerId == existing().ownerId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isWorkspaceOwner(workspaceId) || isAdmin()) && (
            incoming().diff(existing()).affectedKeys().hasOnly(['optedOut', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name',
              'phone',
              'city',
              'lastProductOrdered',
              'segment',
              'totalOrders',
              'totalSpent',
              'outstandingUdhaar',
              'aiInsight',
              'updatedAt'
            ]) ||
            isAdmin()
          );

        allow delete: if isEmailVerified() &&
          isValidId(workspaceId) &&
          isValidId(customerId) &&
          (isWorkspaceOwner(workspaceId) || isAdmin());
      }

      // Draft Revisions Subcollection
      match /draftRevisions/{revisionId} {
        allow get: if isSignedIn() && isValidId(workspaceId) && isValidId(revisionId) && (isWorkspaceOwner(workspaceId) || isAdmin());
        allow list: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isBootstrappedAdmin());

        allow create: if isEmailVerified() &&
          isValidId(workspaceId) &&
          isValidId(revisionId) &&
          isValidDraftRevision(incoming(), workspaceId, revisionId) &&
          incoming().ownerId == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          isWorkspaceOwner(workspaceId);

        allow update: if isEmailVerified() &&
          isValidId(workspaceId) &&
          isValidId(revisionId) &&
          isValidDraftRevision(incoming(), workspaceId, revisionId) &&
          incoming().id == existing().id &&
          incoming().workspaceId == existing().workspaceId &&
          incoming().ownerId == existing().ownerId &&
          incoming().approvalId == existing().approvalId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isWorkspaceOwner(workspaceId) || isAdmin()) && (
            (
              existing().status in ['edited', 'scheduled'] &&
              incoming().diff(existing()).affectedKeys().hasOnly(['message', 'status', 'updatedAt'])
            ) ||
            isAdmin()
          );

        allow delete: if isEmailVerified() &&
          isValidId(workspaceId) &&
          isValidId(revisionId) &&
          (isWorkspaceOwner(workspaceId) || isAdmin());
      }
    }
  }
}
